# Copy to .env. Never commit .env or service-account credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/chat_backend

# Your Firebase project ID and the downloaded Admin SDK key stored OUTSIDE this project.
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:/firebase-keys/chat-service-account.json

# Optional emulator: comment out GOOGLE_APPLICATION_CREDENTIALS and use these instead.
# FIREBASE_PROJECT_ID=demo-chat-backend
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Real integration tests use ONLY these dedicated test settings, never DATABASE_URL.
# TEST_DATABASE_URL=mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/chat_backend_test
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
